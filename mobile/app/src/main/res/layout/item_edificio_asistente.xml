<?xml version="1.0" encoding="utf-8"?>
<!-- Edificio en el perfil de un asistente: si está autorizado y qué puede hacer ahí -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEdificio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/consora_navy"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Edificio Norte" />

            <TextView
                android:id="@+id/tvDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/consora_gray"
                android:textSize="13sp"
                tools:text="Av. del Libertador 6200, CABA" />
        </LinearLayout>

        <!-- Switch: habilita o deshabilita al asistente en este edificio -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swHabilitado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/asistente_habilitado" />
    </LinearLayout>

    <!-- Opciones del edificio (permisos); se agregan desde el código -->
    <com.google.android.material.chip.ChipGroup xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/permisos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp" />
</LinearLayout>
