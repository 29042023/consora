<?xml version="1.0" encoding="utf-8"?>
<!-- Una tarea del asistente: tilde (completada) + descripción y fecha -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbCompletada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:buttonTint="@color/consora_teal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/consora_navy"
            android:textSize="15sp"
            tools:text="Cargar las facturas de luz de octubre" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/consora_gray"
            android:textSize="13sp"
            tools:text="En proceso · 27/10/2026" />
    </LinearLayout>
</LinearLayout>
