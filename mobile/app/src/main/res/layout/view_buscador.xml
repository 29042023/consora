<?xml version="1.0" encoding="utf-8"?>
<!-- Buscador (Marketplace, Asistentes, Chats, Consorcios):campo de búsqueda + botón de filtros. El hint se pone desde el código -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <EditText
        android:id="@+id/etBuscar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/bg_input"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:drawableTint="@color/consora_gray"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/consora_navy"
        android:textColorHint="@color/consora_gray"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/btnFiltros"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_input"
        android:contentDescription="@string/marketplace_filtros"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_filter"
        app:tint="@color/consora_navy" />
</LinearLayout>
