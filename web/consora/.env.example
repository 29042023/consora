# Copiá este archivo como .env (en la misma carpeta que manage.py) y completá los datos.
# El .env no se sube al repositorio: tiene la clave secreta y las contraseñas.

# Django: generá una clave con
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos MySQL / MariaDB
DB_NAME=consora_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Google Calendar / Meet: credenciales OAuth 2.0 (Aplicación web) de Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/google/callback/
